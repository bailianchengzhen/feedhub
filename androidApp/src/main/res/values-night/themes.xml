<?xml version="1.0" encoding="utf-8"?>
<!-- 系统夜间模式下的一档（H2）：底色 = Compose 的 Dark.background，父主题也换成深色的，
     免得启动画面的默认底色（?android:colorBackground）还是白的。 -->
<resources>
    <style name="Theme.Feedhub" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
